# Server-only; use the same values in Next and persistent workers.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Cryptographically random, at least 32 characters. Keep stable and recoverable.
# This salt derives both keyed identity hashes and the application encryption key.
TIPPER_HASH_SALT=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
CRON_SECRET=
WORKER_BATCH=8
# Recommended for production. Configure both or leave both blank for local tests.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=www.safuu.net
# Only use false in an isolated local test; staff MFA is required by default.
STAFF_REQUIRE_MFA=true
